@model IEnumerable<Project_Model.Models.ResponseOrderItemDto>

@{
    ViewData["Title"] = "Order Items";

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3>Order Items</h3>
        </div>

        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Sr.No</th>
                        <th>Item Name</th>
                        <th>Qty</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@item.ItemName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price</td>                          
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>