@using Project_Model.Models
@model Project_Model.Models.CreateDtoItem

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="row">


        <div class="col-md-4">

            @using (Html.BeginForm(FormMethod.Post,new{enctype="multipart/form-data"}))
            {

                <div class="card shadow-lg border-0">
                    <div class="card-header bg-primary text-white text-center">
                        <h4>Add Item </h4>
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            @Html.HiddenFor(e=>e.ItemId)
                            <label>Category</label>

                            @Html.DropDownListFor(e => e.Category,ViewBag.categories as SelectList,"Select Category",new { @class = "form-control" }          )
                        </div>

                        <div class="mb-3">
                            <label>Item Name</label>
                            @Html.TextBoxFor(e => e.ItemName,new{@class = "form-control", placeholder = "Enter Item Name"})
                        </div>

                        <div class="mb-3">
                            <label>Price</label>
                            @Html.TextBoxFor(e => e.Price,new{@class = "form-control",placeholder = "Enter Price"})
                        </div>

                        <div class="mb-3">
                            <label>Description</label>

                            @Html.TextAreaFor(e => e.Description,new{@class = "form-control",placeholder = "Enter Description"})
                        </div>

                        <div class="mb-3">
                            <label>Tax</label>
                            @Html.TextBoxFor(e => e.Tax,new{@class = "form-control",placeholder = "Enter Tax"})
                        </div>

                        <div class="mb-3">
                            <label>ImagePhoto</label>
                            <input type="file" name="photo" class="form-control" />
                        </div>

                        <div class="form-check mb-3">
                            @Html.CheckBoxFor(e => e.IsVegeterian,new { @class = "form-check-input" })

                            <label class="form-check-label">
                                Is Vegetarian
                            </label>

                        </div>

                    </div>

                    <div class="card-footer text-center">

                        <input type="submit" value="Save" class="btn btn-success px-4" />

                        <a href="/AdminArea/Items/Index" class="btn btn-secondary px-4">Cancel</a>

                    </div>

                </div>
            }

        </div>


        <div class="col-md-8">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">

                    <tr>
                        <th>Sr.No</th>
                        <th>Category Name</th>
                        <th>Item Name</th>
                        <th>Price</th>
                        <th>ImagePhoto</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @{
                        List<ResponseItemDto> lst = (List<ResponseItemDto>)ViewData["items"];

                        int i = 1;
                    }

                    @foreach (var item in lst)
                    {
                        <tr>

                            <td>@i</td>
                            <td>@item.CategoryName</td>
                            <td>@item.ItemName</td>
                            <td>@item.Price</td>
                            <td>
                                <img src="~/Images/@item.ItemPhoto"
                                     width="80"
                                     height="80" />
                            </td>
                           
                            <td>

                                <a href="~/AdminArea/Items/Edit/@item.ItemId" class="btn btn-danger btn-sm">Edit</a>
                                <br/>
                                <a href="~/AdminArea/Items/Delete/@item.ItemId" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure?')">Delete</a>

                            </td>

                        </tr>

                        i++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>