@using Project_Model.Models
@model Project_Model.Models.CreateDtoCategory

@{
    ViewData["Title"] = "Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="row">

        <div class="col-md-5">

            @using (Html.BeginForm())
            {
                <div class="card shadow-lg border-0">

                    <div class="card-header bg-primary text-white text-center">
                        <h4 class="mb-0">Add Category</h4>
                    </div>

                    <div class="card-body">
                        <label class="fw-bold">Category Name</label>
                        @Html.TextBoxFor(e => e.CategoryName,
                                 new { @class = "form-control", placeholder = "Enter Category Name" })

                    </div>

                    <div class="card-footer text-center">
                        <input type="submit" value="Save" class="btn btn-success px-4" />
                        <a href="/AdminArea/MessDetails/Index" class="btn btn-secondary px-4">Cancel</a>
                    </div>

                </div>
            }

        </div>

        <div class="col-md-7">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Sr.No</th>
                        <th>Category Name</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        List<TblCategory> lst = (List<TblCategory>)ViewData["categories"];
                        int i = 1;
                    }

                    @foreach (var item in lst)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@item.CategoryName</td>
                            <td>
                                <a href="~/AdminArea/Categories/Delete/@item.CategoryId"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this record?')">

                                    Delete
                                </a>
                            </td>
                        </tr>
                        i++;
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>