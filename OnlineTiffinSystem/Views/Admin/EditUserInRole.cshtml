@model List<Project_Model.Models.UserRoleViewModel>
@{
    ViewData["Title"] = "EditUserInRole";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var roleid = ViewBag.RoleId;
}
<form method="post">
    <div class="card">
        <div class="card-header">
            <h4>@ViewBag.RoleName</h4>
        </div>

        <div class="card-body">
            <h4> Add or remove From this Role</h4>
            @for(int i=0;i<Model.Count;i++)
            {
                <div>
                    @Html.CheckBoxFor(e=>Model[i].IsSelected)
                    <span>@Model[i].UserName</span>
                    @Html.HiddenFor(e=>Model[i].UserName)
                    @Html.HiddenFor(e=>Model[i].UserId)

                </div>
            }
        </div>
        <div class="card-footer">
        <input type="submit" value="Submit" class="btn btn-primary" />
        </div>
    </div>
</form>





